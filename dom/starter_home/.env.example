# Copy to .env and fill in. Never commit .env.
TELEGRAM_BOT_TOKEN=
OPENROUTER_API_KEY=
# Only if a model endpoint in config.toml uses api_key_env = "MODEL_API_KEY" (e.g. a homelab server)
MODEL_API_KEY=
# Optional: lets Dom send GIFs (KLIPY, see docs/gifs.md). Leave empty to keep GIFs off.
KLIPY_API_KEY=
# Optional: cloud web search providers if enabled in [models.search]
DEEPSEEK_API_KEY=
TAVILY_API_KEY=
# Auto-generated on first saved login or encrypted secret (32-byte base64url key; rotate with `dom rotate-key`)
# DOM_MASTER_KEY=
